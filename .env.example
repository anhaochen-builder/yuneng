# DeepSeek 配置（必填，注册地址: https://platform.deepseek.com）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# 开发模式 — 禁用 JWT 认证（生产环境请删除此行）
DISABLE_AUTH=1

# Qwen-DashScope 多模态（可选，注册地址: https://dashscope.aliyun.com）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 诊断引擎 (ensemble=双模型, single=快模型, auto=智能切换)
DIAGNOSIS_MODE=ensemble

# 混合部署 (auto=自动降级, force-online=仅在线, force-offline=仅离线)
OFFLINE_MODE=auto

# 本地 Qwen GGUF 模型路径（可选，离线时使用 CPU 推理）
QWEN_LOCAL_PATH=

# 向量数据库
VECTOR_DB_PATH=./knowledge_db
KNOWLEDGE_PATH=./data

# 服务配置
API_HOST=0.0.0.0
API_PORT=8080
MCP_PORT=9901

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 模型下载镜像（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# 嵌入与重排模型（可选覆盖）
# EMBEDDING_MODEL=maidalun1020/bce-embedding-base_v1
# RERANK_MODEL=maidalun1020/bce-reranker-base_v1

# Neo4j 图数据库（可选，未配置时自动降级为内存图）
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_password_here

# 数据目录
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
