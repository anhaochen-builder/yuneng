# 驭能 MCP 工具服务 — 多阶段构建

FROM python:3.11-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ curl && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /install /usr/local
COPY mcp_server/ ./mcp_server/
COPY app/ ./app/
RUN useradd --create-home --shell /bin/bash yuneng && chown -R yuneng:yuneng /app
USER yuneng
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import mcp_server.tools" || exit 1
CMD ["python", "-m", "mcp_server.server"]
